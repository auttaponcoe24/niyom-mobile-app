#!/usr/bin/env sh
set -e

# Husky runs with a minimal PATH — load nvm when available
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
  nvm use node >/dev/null 2>&1 || true
fi

export PATH="$(pwd)/node_modules/.bin:$PATH"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)
[ -z "$STAGED_FILES" ] && exit 0

# Biome only on staged source/config files (skip assets / markdown)
BIOME_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|mts|cts|json)$' || true)

if [ -n "$BIOME_FILES" ]; then
  echo "🔍 Running Biome on staged files..."
  # Split on newlines only so paths with spaces stay intact (macOS-friendly, no xargs)
  OLDIFS=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $BIOME_FILES
  IFS=$OLDIFS
  pnpm exec biome check --write --no-errors-on-unmatched --files-ignore-unknown=true "$@"
fi

# Re-stage files Biome may have rewritten
git update-index --again

echo "✅ Pre-commit checks passed"
